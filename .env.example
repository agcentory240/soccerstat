# ===== База данных PostgreSQL =====
DB_HOST=postgres
DB_PORT=5432
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=mydb

# ===== AI-провайдер (DeepSeek) =====
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-flash

# ===== RabbitMQ =====
RABBITMQ_URI=amqp://guest:guest@rabbitmq:5672

# ===== Redis (pub/sub состояния для фронтенда) =====
# В Docker Compose: redis://redis:6379
# При локальном запуске API без Docker: redis://localhost:6379
REDIS_URL=redis://redis:6379

# ===== HTTP-сервер =====
PORT=3000
