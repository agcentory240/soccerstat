# Локальные переопределения для запуска API без Docker.
# Скопируйте файл в app/.env — значения отсюда имеют приоритет
# над корневым .env (адреса Docker-сервисов заменяются на localhost).
#
#   cp app/.env.example app/.env
#
# Не коммитьте app/.env: он исключён из git правилом `.env`.

# ===== База данных PostgreSQL =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=mydb

# ===== AI-провайдер (DeepSeek) =====
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-flash

# ===== RabbitMQ =====
RABBITMQ_URI=amqp://guest:guest@localhost:5672

# ===== Redis (pub/sub состояния для фронтенда) =====
REDIS_URL=redis://localhost:6379

# ===== HTTP-сервер =====
PORT=3000
